{
  "name": "@blockr/ui",
  "private": true,
  "description": "The components of blockr.ui's client, Lucide's icons, and the build preset with which a package builds its modules and its stylesheet against them, as the R package blockr.ui ships them.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./build": {
      "types": "./build/index.d.ts",
      "default": "./build/index.js"
    },
    "./icons": {
      "types": "./icons/index.d.ts",
      "default": "./icons/index.js"
    },
    "./stubs": {
      "types": "./stubs/index.d.ts",
      "default": "./stubs/index.js"
    },
    "./stubs/setup": {
      "types": "./stubs/setup.d.ts",
      "default": "./stubs/setup.js"
    },
    "./preset.css": "./preset.css"
  },
  "dependencies": {
    "@internationalized/date": "3.12.4",
    "lucide": "1.75.0"
  },
  "peerDependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-aria-components": "1.22.1",
    "react-aria": "3.53.1",
    "react-stately": "3.51.0"
  }
}
